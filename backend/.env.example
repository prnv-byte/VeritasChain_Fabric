# Copy this file to .env and fill in your values
# cp .env.example .env

# MongoDB Atlas connection string
# Get this from: Atlas Dashboard → Connect → Drivers
MONGODB_URI=

# Backend port (keep at 3000 — frontend proxy expects this)
PORT=3000

# Platform secret — used to generate unique org identifiers
# Must be the same across all team members
PLATFORM_SECRET=veritaschain_2626

# Admin key — used to access /admin panel on the frontend
# Keep this secret — only share with platform admins
ADMIN_KEY=vc_admin_secret_2626
