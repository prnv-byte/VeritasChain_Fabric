# ── Generated crypto material — NEVER commit (runtime-generated, private keys) ──
# The entire organizations tree (CA certs, MSP, TLS, keys) is created by the
# provisioning scripts at runtime — never tracked.
network/organizations/

# ── Generated at runtime — rebuild with scripts ────────────────────────────────
ledger/
prototype/ledger/
network/ledger/
network/channel-artifacts/

# ── Node dependencies — install with npm install ───────────────────────────────
node_modules/
backend/node_modules/
frontend/node_modules/

# ── Frontend build output — regenerate with: npm run build ────────────────────
frontend/dist/

# ── Lock files ─────────────────────────────────────────────────────────────────
backend/package-lock.json
frontend/package-lock.json

# ── Go vendor — regenerate with: go mod vendor ────────────────────────────────
chaincode/order/vendor/

# ── Claude Code workspace ──────────────────────────────────────────────────────
.claude/

# ── Go build artifacts ─────────────────────────────────────────────────────────
chaincode/*/*.test
chaincode/order/order

# ── ZK compiled binaries — rebuild with: cd zk && go build -o dist/... ─────────
zk/dist/

# ── ZK generated keys & supplier proofs — NEVER commit (private proving keys) ──
backend/keys/
backend/proofs/

# ── Environment files ─────────────────────────────────────────────────────────
.env
*.env
backend/.env

# ── OS files ───────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Misc ───────────────────────────────────────────────────────────────────────
deploy-output.txt
prototype/deploy-output.txt
